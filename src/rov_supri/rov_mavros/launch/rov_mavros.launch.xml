<launch>
    <arg name="param_dir" default="$(find-pkg-share rov_mavros)/config"
         description="Directory that contains the parameter files"/>
    <arg name="pluginlists_file" default="apm_pluginlists.yaml"/>
    <arg name="apm_config_file" default="apm_config.yaml"/>
    <arg name="mavros_param_file" default="mavros.yaml"/>
    <arg name="slam_mavros_file" default="slam_to_mavros.yaml"/>

    <arg name="use_sim" default="false"/>
    <arg name="sim_url" default="udp://:14550@"/>
    <arg name="real_fc_url" default="serial:///dev/ttyACM0:921600"/>

    <let name="fcu_url" value="$(eval '\'$(var real_fc_url)\' if \'$(var use_sim)\' == \'false\' else \'$(var sim_url)\'')"/>
    <let name="conn_timeout" value="$(eval '10.0 if \'$(var use_sim)\' == \'false\' else 120.0')"/>

    <node pkg="mavros" exec="mavros_node" output="screen">
        <param from="$(var param_dir)/$(var pluginlists_file)"/>
        <param from="$(var param_dir)/$(var apm_config_file)"/>
        <param from="$(var param_dir)/$(var mavros_param_file)"/>
        <param name="fcu_url" value="$(var fcu_url)"/>
        <param name="conn.timeout" value="$(var conn_timeout)"/>
    </node>

    <include file="$(find-pkg-share rov_mavros)/launch/slam_to_mavros.launch.xml">
        <arg name="param_dir" value="$(var param_dir)"/>
        <arg name="param_file" value="$(var slam_mavros_file)"/>
        <arg name="use_sim_time" value="$(var use_sim)"/>
    </include>
</launch>
