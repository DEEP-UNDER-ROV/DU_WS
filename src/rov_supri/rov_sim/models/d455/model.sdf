<?xml version="1.0"?>
<sdf version="1.9">
  <model name="d455">
    <link name="d455_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        </inertia>
      </inertial>

      <visual name="d455_visual">
        <geometry><box><size>0.026 0.124 0.029</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- RGB + depth + pointcloud -->
      <sensor name="d455_rgbd" type="rgbd_camera">
        <pose>0 0.0475 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <topic>camera</topic>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <!-- <clip><near>0.4</near><far>20.0</far></clip> -->
          <depth_camera>
            <clip><near>0.4</near><far>20.0</far></clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- IR left (infra1) -->
      <sensor name="d455_infra1" type="camera">
        <pose>0 0.0475 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <topic>camera/infra1/image</topic>
        <gz_frame_id>camera_infra1_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- IR right (infra2) -->
      <sensor name="d455_infra2" type="camera">
        <pose>0 -0.0475 0 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <topic>camera/infra2/image</topic>
        <gz_frame_id>camera_infra2_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>848</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- IMU -->
      <sensor name="d455_imu" type="imu">
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <topic>camera/imu</topic>
        <gz_frame_id>camera_imu_optical_frame</gz_frame_id>
      </sensor>
    </link>
  </model>
</sdf>
