<launch>
    <arg name="param_dir" default="$(find-pkg-share rov_sim)/config"
         description="Directory that contains the ArduSub param file" />
    <arg name="param_file" default="ardusupri.params"
         description="Extra ArduSub param file name, resolved inside param_dir" />
    <arg name="instance" default="0" description="Instance ID (0, 1, 2...)" />
    <arg name="sysid" default="1" description="MAVLink System ID" />
    <arg name="use_map" default="false" />
    <arg name="use_console" default="false" />
    <let name="map_flag" value="$(eval '\'--map\' if \'$(var use_map)\' == \'true\' else \'\'')" />
    <let name="console_flag" value="$(eval '\'--console\' if \'$(var use_console)\' == \'true\' else \'\'')" />

    <executable cmd="@ARDUSUPRI_DIR@/Tools/autotest/sim_vehicle.py 
        -v ArduSub
        -f vectored
        --model JSON 
        -N
        -I $(var instance) 
        --sysid $(var sysid)
        --add-param-file $(var param_dir)/$(var param_file)
        $(var map_flag) 
        $(var console_flag)" 
        cwd="@ARDUSUPRI_DIR@"
        output="screen" 
    />
</launch>
